<mxfile host="app.diagrams.net">
  <diagram id="architecture" name="Arhitektuur">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Pealkiri -->
        <mxCell id="title" value="Eesti vaatamisväärsuste veebirakendus – arhitektuur (kihiline monoliit)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- Alad (taustakastid) -->
        <mxCell id="zoneBrowser" value="Kasutaja brauser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="300" height="320" as="geometry" />
        </mxCell>
        <mxCell id="zoneServer" value="Server: Spring Boot rakendus (kihiline monoliit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="380" height="530" as="geometry" />
        </mxCell>

        <!-- Kasutajad -->
        <mxCell id="visitor" value="Külastaja" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="170" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="Administraator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="320" width="30" height="60" as="geometry" />
        </mxCell>

        <!-- Brauseri komponendid -->
        <mxCell id="webui" value="&lt;b&gt;Veebiliides&lt;/b&gt;&lt;br&gt;HTML, CSS, JavaScript&lt;br&gt;kaart, nimekiri, detailvaade, haldusvaade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="230" y="150" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="leaflet" value="&lt;b&gt;Leaflet&lt;/b&gt;&lt;br&gt;kaardi ja märkide joonistamine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="230" y="340" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Serveri komponendid -->
        <mxCell id="security" value="&lt;b&gt;Turvamoodul&lt;/b&gt; (Spring Security)&lt;br&gt;sisselogimine seansiküpsisega, õiguste kontroll" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="160" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API kiht&lt;/b&gt; (Controllers)&lt;br&gt;võtab päringud vastu, kontrollib sisendit,&lt;br&gt;tagastab JSON-i või pildifaili" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="280" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="service" value="&lt;b&gt;Äriloogika kiht&lt;/b&gt; (Services)&lt;br&gt;filtreerimine, reeglid, vahemälu uuendamine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="380" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="repository" value="&lt;b&gt;Andmekiht&lt;/b&gt;&lt;br&gt;(Repositories)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="510" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="photostore" value="&lt;b&gt;Pildihoidla&lt;/b&gt;&lt;br&gt;serveri ketas&lt;br&gt;(fotod)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="940" y="500" width="140" height="90" as="geometry" />
        </mxCell>

        <!-- Andmebaas -->
        <mxCell id="database" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;vaatamisväärsused, kasutajad,&lt;br&gt;lemmikud, arvustused" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="720" y="720" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Väline teenus -->
        <mxCell id="tiles" value="&lt;b&gt;Väline kaarditeenus&lt;/b&gt;&lt;br&gt;OpenStreetMapi põhine&lt;br&gt;(kaardipildid)" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="640" width="260" height="130" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pidev nool: päring meie serverisse või serveri sees&lt;br&gt;Katkendlik nool: päring välisesse teenusesse&lt;br&gt;Kahe otsaga nool: päring ja vastus samas ühenduses&lt;br&gt;Silinder: andmete hoidla&lt;br&gt;Pilv: väline teenus&lt;br&gt;&lt;br&gt;Pildihoidla asub serveris. Brauser ei pääse sinna otse,&lt;br&gt;fotod antakse välja turvamooduli ja API kihi kaudu." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1160" y="120" width="340" height="230" as="geometry" />
        </mxCell>

        <!-- Ühendused -->
        <mxCell id="e1" value="kasutab" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="visitor" target="webui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="haldusvaade" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="admin" target="webui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="kuvab kaardi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="webui" target="leaflet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="HTTPS: kaardipildid otse&lt;br&gt;(ei liigu läbi meie serveri)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="leaflet" target="tiles">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="HTTPS, REST API&lt;br&gt;vastus: andmed JSON-vormingus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;exitX=1;exitY=0.2;entryX=0;entryY=0.25;" edge="1" parent="1" source="webui" target="security">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="HTTPS, foto päring&lt;br&gt;vastus: pildifail (nt JPEG)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;exitX=1;exitY=0.8;entryX=0;entryY=0.75;" edge="1" parent="1" source="webui" target="security">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="kontrollitud päring" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="security" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="meetodikutse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="api" target="service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="meetodikutse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.2353;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="service" target="repository">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="fotode lugemine&lt;br&gt;ja salvestamine" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.7941;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="service" target="photostore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.4545;entryY=0;" edge="1" parent="1" source="repository" target="database">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
